{
  "name": "agentbrake",
  "version": "2.0.0",
  "description": "MCP proxy that enforces policy on AI agent tool calls and tracks secret data across calls (winnowing fingerprints) to stop exfiltration, SSRF and path traversal.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "agent-brake": "dist/src/proxy/index.js"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build && npm test",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "tsc --noEmit",
    "gauntlet": "npm run build && node dist/bench/gauntlet.js",
    "bench": "npm run build && node dist/bench/latency.js",
    "demo:rogue": "npm run build && node dist/examples/rogue-agent-attack.js",
    "demo:research": "npm run build && node dist/examples/research-agent.js",
    "demo:gif": "npm run build && node dist/bench/demo/capture.js && python bench/demo/render_gif.py"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-safety",
    "agent",
    "security",
    "governance",
    "proxy",
    "middleware",
    "policy-engine",
    "dlp",
    "circuit-breaker",
    "rate-limiting",
    "human-in-the-loop",
    "data-flow",
    "taint-tracking",
    "exfiltration",
    "ssrf",
    "winnowing",
    "prompt-injection"
  ],
  "author": "Ujjwal Jain",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ujjwaljain16/AgentBrake.git"
  },
  "homepage": "https://github.com/Ujjwaljain16/AgentBrake#readme",
  "bugs": {
    "url": "https://github.com/Ujjwaljain16/AgentBrake/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.2.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
