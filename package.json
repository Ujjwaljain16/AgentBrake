{
  "name": "agentbrake",
  "version": "1.0.0",
  "description": "The safety control plane for AI agents — a transparent MCP proxy that enforces security policies on tool calls in real-time.",
  "main": "dist/src/proxy/index.js",
  "types": "dist/src/proxy/index.d.ts",
  "bin": {
    "agent-brake": "./dist/src/proxy/index.js"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build && npm test",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "tsc --noEmit",
    "demo:rogue": "npm run build && node dist/examples/rogue-agent-attack.js",
    "demo:research": "npm run build && node dist/examples/research-agent.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-safety",
    "agent",
    "security",
    "governance",
    "proxy",
    "middleware",
    "policy-engine",
    "dlp",
    "circuit-breaker",
    "rate-limiting",
    "human-in-the-loop"
  ],
  "author": "Ujjwal Jain",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ujjwaljain16/AgentBrake.git"
  },
  "homepage": "https://github.com/Ujjwaljain16/AgentBrake#readme",
  "bugs": {
    "url": "https://github.com/Ujjwaljain16/AgentBrake/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.2.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
