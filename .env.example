# AgentBrake Configuration Path (also looked up as ./agent-brake.yml|yaml|json)
# AGENT_BRAKE_CONFIG=/app/agent-brake.yml

# Not recommended: start with built-in defaults if the config is invalid (default: refuse to start)
# AGENT_BRAKE_ALLOW_INVALID_CONFIG=1

# Max size in bytes of one client message line (default 10485760)
# AGENT_BRAKE_MAX_MESSAGE_BYTES=10485760

# NOT WIRED IN YET: WebhookNotifier exists in src/notifications/webhook.ts but the proxy does not
# call it, so these have no effect.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# WEBHOOK_URL=https://your-monitoring-system.com/webhook
