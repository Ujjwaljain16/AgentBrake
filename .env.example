# Path to the config file (default: ./agent-brake.yml, .yaml or .json)
# AGENT_BRAKE_CONFIG=/app/agent-brake.yml

# Largest accepted client message in bytes (default 10485760)
# AGENT_BRAKE_MAX_MESSAGE_BYTES=10485760

# Start with built-in defaults if the config is invalid (default: refuse to start). Not recommended.
# AGENT_BRAKE_ALLOW_INVALID_CONFIG=1
